{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es6",
    "lib": ["ESNext"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "composite": false,
    "moduleResolution": "bundler",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "vite-config"]
}
